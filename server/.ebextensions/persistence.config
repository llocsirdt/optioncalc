# AWS Elastic Beanstalk Configuration for Persistence
# This configuration handles persistence requirements for EB deployment

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    PERSISTENCE_PATH: /tmp/server-state.json
    BACKUP_PATH: /tmp/server-state.backup.json
    # Candle-spread run logs live OUTSIDE /var/app/current so a deploy can't wipe them.
    # /tmp survives deploys and is already proven-writable (see PERSISTENCE_PATH above); the
    # store's mkdirSync creates the dir. Until the S3 backup is wired this is the durable
    # server-side store; the analyze tool also caches every fetch locally as a backstop.
    CANDLE_SPREAD_RUNS_DIR: /tmp/candle-spread-runs

  aws:autoscaling:launchconfiguration:
    DisableIMDSv1: true

container_commands:
  01_install_dependencies:
    command: "npm install --production"
    leader_only: true
