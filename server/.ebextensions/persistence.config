# AWS Elastic Beanstalk Configuration for Persistence
# This configuration handles persistence requirements for EB deployment

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    PERSISTENCE_PATH: /tmp/server-state.json
    BACKUP_PATH: /tmp/server-state.backup.json
    
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: "npm start"
    
  aws:elasticbeanstalk:environment:process:
    ProxyServer:
      Command: "node proxy-server-sdk.js"
      Enabled: true
      Memory: 512
      
files:
  /tmp/persistence-dir:
    mode: "000755"
    owner: nodejs
    group: nodejs
    source: null
    
container_commands:
  01_create_persistence_dir:
    command: "mkdir -p /tmp/persistence-dir"
    leader_only: true
    
  02_set_permissions:
    command: "chmod 755 /tmp/persistence-dir"
    leader_only: true
    
  03_install_dependencies:
    command: "npm install --production"
    leader_only: true
