# AWS Elastic Beanstalk configuration.
#
# Persistent app data lives on the ROOT DISK (8 GB), NOT /tmp. On this platform /tmp is a RAM-backed
# tmpfs (~458 MB ≈ half the 1 GB instance RAM), so writing the growing candle-spread run store (a
# full chain snapshot per candle, per variant, all day) to /tmp consumed RAM and competed with the
# app — the mechanism behind the recurring OOM AND the 2026-08-28 deploy hang. /var/optioncalc-data
# is on the real root disk (created below, survives deploys since it's outside /var/app/current).
#
# NOTE: the old PERSISTENCE_PATH / BACKUP_PATH settings were removed — the code never read them;
# persistence.js already writes server-state.json inside the app dir (root disk), so it was never
# the RAM issue.

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    CANDLE_SPREAD_RUNS_DIR: /var/optioncalc-data/candle-spread-runs
    NQ_NDX_BASIS_PATH: /var/optioncalc-data/nq-ndx-basis.json

  aws:autoscaling:launchconfiguration:
    DisableIMDSv1: true

container_commands:
  # Create the persistent data dir on the root disk. World-writable + sticky (1777, same mode as
  # /tmp) so the app can write it regardless of which user the platform runs Node as; the sticky bit
  # prevents cross-deletion. Idempotent (mkdir -p) and runs on every instance.
  00_create_data_dir:
    command: "mkdir -p /var/optioncalc-data/candle-spread-runs && chmod -R 1777 /var/optioncalc-data"
  01_install_dependencies:
    command: "npm install --production"
    leader_only: true
