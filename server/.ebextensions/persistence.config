# AWS Elastic Beanstalk configuration.
#
# Persistent app data lives on the ROOT DISK (8 GB), NOT /tmp. On this platform /tmp is a RAM-backed
# tmpfs (~458 MB ≈ half the 1 GB instance RAM), so writing the growing candle-spread run store (a
# full chain snapshot per candle, per variant, all day) to /tmp consumed RAM and competed with the
# app — the mechanism behind the recurring OOM AND the 2026-08-28 deploy hang. /var/optioncalc-data
# is on the real root disk (created below, survives deploys since it's outside /var/app/current).
#
# NOTE: the old PERSISTENCE_PATH / BACKUP_PATH settings were removed — the code never read them;
# persistence.js already writes server-state.json inside the app dir (root disk), so it was never
# the RAM issue.

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    CANDLE_SPREAD_RUNS_DIR: /var/optioncalc-data/candle-spread-runs
    NQ_NDX_BASIS_PATH: /var/optioncalc-data/nq-ndx-basis.json
    # OFF-INSTANCE DURABILITY (run-archive.js). The local store above is on the root disk, which survives an
    # in-place restart but NOT instance replacement — a fresh EBS volume means an empty store and a lost
    # book (2026-09-01, and again 2026-09-29 20:11 ET). Set CANDLE_SPREAD_S3_BUCKET on the ENVIRONMENT
    # (console or `eb setenv`), not here, because the bucket is account-specific and does not belong in the
    # repo. The instance profile also needs s3:PutObject/GetObject/ListBucket on it — the default
    # aws-elasticbeanstalk-ec2-role does NOT grant that, so add a policy or the archive stays disabled.
    # /health -> candleRunArchive reports exactly which of those is missing.
    #   CANDLE_SPREAD_S3_BUCKET        (required to enable; unset = local disk only, today's behaviour)
    #   CANDLE_SPREAD_S3_PREFIX        (default candle-spread-runs)
    #   CANDLE_SPREAD_S3_RESTORE_DAYS  (0 = today only; e.g. 30 also restores history for the UI, behind
    #                                   the engine so it never delays a tick)
    # REMOTE STRATEGY CONTROL (strategy-control.js). A JSON object at
    # <prefix>/_control/strategy-control.json decides which variants trade and in what mode; anything not
    # listed there is simulation only. Editing it in the S3 console is enough — the engine picks changes up on
    # the 20s order-poll tick. Set CANDLE_SPREAD_CONTROL_TOKEN only if you also want the write API
    # (POST /api/v1/candle-spread/control, token in the x-control-token HEADER); with it unset the endpoint is
    # OFF rather than open, and the file remains editable by hand. There is deliberately no default token.
    #
    # mode:'live' in that file is a REQUEST — it is honoured only when CANDLE_SPREAD_LIVE is already true, and
    # downgraded to paper otherwise. Stopping is fast and remote; starting real-money trading stays deliberate.
    #   CANDLE_SPREAD_CONTROL_TOKEN    (unset = write API disabled; the file is still hand-editable)

  aws:autoscaling:launchconfiguration:
    DisableIMDSv1: true

container_commands:
  # Create the persistent data dir on the root disk. World-writable + sticky (1777, same mode as
  # /tmp) so the app can write it regardless of which user the platform runs Node as; the sticky bit
  # prevents cross-deletion. Idempotent (mkdir -p) and runs on every instance.
  00_create_data_dir:
    command: "mkdir -p /var/optioncalc-data/candle-spread-runs && chmod -R 1777 /var/optioncalc-data"
  01_install_dependencies:
    command: "npm install --production"
    leader_only: true
  # (The run-store repair used to live here. It CANNOT work from a deploy hook: the hook runs as a user
  # that may create files in the 1777 store directory but cannot overwrite a record the app owns, so on
  # 2026-09-17 it reclaimed an orphaned backup and then failed EACCES on the rewrite. The app does it at
  # startup instead -- see the sweepStore call in candle-spread/index.js start() -- where the identity is
  # right by construction. prune-runaway-hedges.js is still shipped for manual use over `eb ssh`.)
